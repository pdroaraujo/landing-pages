# Força HTTPS + SPA fallback (rotas /admin, /login servidas pelo index.html)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA: qualquer caminho que não seja arquivo/pasta real cai no index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Página 404 customizada
ErrorDocument 404 /404.html

# Compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Cache do navegador (arquivos com hash no nome do Vite podem ter cache longo;
# o index.html NUNCA pode ficar em cache, senão o site quebra por até 1h depois
# de cada deploy referenciando um JS/CSS com hash antigo que já não existe mais)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cabeçalhos de segurança + cache explícito (Cache-Control tem prioridade sobre
# Expires na maioria dos navegadores e é o que o Lighthouse/hospedagem checam)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpe?g|webp|svg|woff2?|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
