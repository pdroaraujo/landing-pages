# ---- Frontend (Vite) ----
# Supabase project — Project Settings > API / API Keys
VITE_SUPABASE_URL=https://qzjjyyzhypnybhswwmnm.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# ---- Supabase Edge Functions (set via: supabase secrets set) ----
# NÃO vão para o frontend. Configurar no painel Supabase ou CLI.
# GEMINI_API_KEY=AQ.xxx  (ou AIza... — os dois formatos funcionam)
# GEMINI_MODEL=gemini-flash-lite-latest

# Painel do cliente S7 Card: link de pagamento da mensalidade (R$10/mês).
# Se ficar vazio, o botão "Assinar" abre o WhatsApp da S7.
VITE_S7CARD_ASSINATURA_URL=

# Loja (Yampi) — NÃO vão no .env do front: são secrets da Edge Function "yampi"
#   npx supabase secrets set YAMPI_ALIAS=... YAMPI_USER_TOKEN=... YAMPI_SECRET_KEY=...
